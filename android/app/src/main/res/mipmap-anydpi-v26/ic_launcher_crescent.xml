<?xml version="1.0" encoding="utf-8"?>
<!-- Crescent mark. Foreground and monochrome are vectors, so one file serves
     every density. The monochrome layer is what Android 13+ tints to match the
     wallpaper in themed-icon mode; without it this icon would be the only one
     on the homescreen that ignores the theme. It is a single colour by
     definition, so the red slash reads white there. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_launcher_crescent_fg" />
    <monochrome android:drawable="@drawable/ic_launcher_crescent_mono" />
</adaptive-icon>
