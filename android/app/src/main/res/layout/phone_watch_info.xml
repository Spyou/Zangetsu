<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait watch-page info panel, inflated below the 16:9 video container.
     Landscape never shows it (gone + video expands). All rows reuse the
     existing player menus — this file is presentation only. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/watch_info"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/phone_player_background"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/watch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/phone_player_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/watch_episode_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/phone_player_on_surface_variant"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/watch_action_server"
                    style="@style/PhonePlayerWatchAction"
                    android:text="@string/phone_player_watch_server" />

                <Button
                    android:id="@+id/watch_action_audio"
                    style="@style/PhonePlayerWatchAction"
                    android:text="@string/phone_player_watch_audio" />

                <Button
                    android:id="@+id/watch_action_subtitles"
                    style="@style/PhonePlayerWatchAction"
                    android:text="@string/phone_player_title_subtitles" />

                <Button
                    android:id="@+id/watch_action_more"
                    style="@style/PhonePlayerWatchAction"
                    android:text="@string/phone_player_title_more" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/watch_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/phone_player_on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/watch_see_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/phone_player_watch_see_more"
            android:textColor="@color/phone_player_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/watch_comments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/phone_player_action_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_player_watch_comments"
                    android:textColor="@color/phone_player_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_player_watch_coming_soon"
                    android:textColor="@color/phone_player_on_surface_variant"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/phone_player_on_surface_variant"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/phone_player_up_next_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/phone_player_watch_up_next"
                android:textColor="@color/phone_player_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_player_watch_autoplay"
                android:textColor="@color/phone_player_on_surface_variant"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/watch_autoplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:buttonTint="@color/phone_player_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/watch_next_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/phone_player_action_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/watch_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/phone_player_next_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/phone_player_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/watch_next_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/phone_player_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/phone_player_primary_button"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/phone_player_on_surface"
                android:textSize="20sp" />
        </LinearLayout>

        <Button
            android:id="@+id/watch_all_episodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
