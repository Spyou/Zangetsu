<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="14dp">
    <TextView android:id="@+id/watch_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:maxLines="2" android:ellipsize="end" android:textColor="@android:color/white" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/watch_episode_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="4dp" android:textColor="@color/phone_player_on_surface_variant" android:textSize="13sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="8dp" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/watch_action_server" style="@style/PhonePlayerWatchAction" android:minHeight="40dp" android:layout_marginEnd="8dp" android:text="@string/phone_player_watch_server" />
            <Button android:id="@+id/watch_action_audio" style="@style/PhonePlayerWatchAction" android:minHeight="40dp" android:layout_marginEnd="8dp" android:text="@string/phone_player_watch_audio" />
            <Button android:id="@+id/watch_action_subtitles" style="@style/PhonePlayerWatchAction" android:minHeight="40dp" android:layout_marginEnd="8dp" android:text="@string/phone_player_title_subtitles" />
            <Button android:id="@+id/watch_action_more" style="@style/PhonePlayerWatchAction" android:minHeight="40dp" android:layout_marginEnd="8dp" android:text="@string/phone_player_title_more" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/watch_description_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
        <TextView android:id="@+id/watch_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end" android:textColor="@color/phone_player_on_surface_variant" android:textSize="15sp" />
        <TextView android:id="@+id/watch_see_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:clickable="true" android:focusable="true" android:minHeight="32dp" android:gravity="center_vertical" android:text="@string/phone_player_watch_see_more" android:textColor="@color/phone_player_accent" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/watch_comments" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:clickable="true" android:focusable="true">
        <ImageView android:id="@+id/watch_comments_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/phone_player_tracks" android:tint="@color/phone_player_accent" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/phone_player_watch_comments" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/phone_player_watch_coming_soon" android:textColor="@color/phone_player_on_surface_variant" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:text="›" android:textColor="@color/phone_player_on_surface_variant" android:textSize="24sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingHorizontal="16dp" android:paddingBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/watch_episode_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/watch_search" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:padding="8dp" android:scaleType="centerInside" android:contentDescription="@string/phone_player_watch_search" android:tint="@android:color/white" />
        <ImageButton android:id="@+id/watch_grid" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:padding="8dp" android:scaleType="centerInside" android:contentDescription="@string/phone_player_watch_grid" android:tint="@android:color/white" />
        <ImageButton android:id="@+id/watch_episode_more" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:padding="8dp" android:scaleType="centerInside" android:contentDescription="@string/phone_player_title_more" android:tint="@android:color/white" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/watch_ranges_scroll" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/watch_ranges" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" />
    </HorizontalScrollView>
    <CheckBox android:id="@+id/watch_autoplay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
</LinearLayout>
