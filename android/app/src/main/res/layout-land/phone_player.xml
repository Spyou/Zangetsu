<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/watch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_player_background"
    android:orientation="vertical">

    <!-- Video + control area. Portrait sizes it 16:9 in code; landscape is
         full-bleed. Gestures attach here so the info panel never seeks. -->
    <FrameLayout
        android:id="@+id/player_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="texture_view"
        app:resize_mode="fit"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/top_scrim"
            android:layout_width="match_parent"
            android:layout_height="@dimen/phone_player_top_scrim_height"
            android:layout_gravity="top"
            android:background="@drawable/phone_player_fullscreen_scrim_top" />

        <View
            android:id="@+id/bottom_scrim"
            android:layout_width="match_parent"
            android:layout_height="@dimen/phone_player_bottom_scrim_height"
            android:layout_gravity="bottom"
            android:background="@drawable/phone_player_fullscreen_scrim_bottom" />

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/phone_player_top_bar_side_margin"
            android:layout_marginTop="@dimen/phone_player_top_bar_top_margin"
            android:layout_marginEnd="@dimen/phone_player_top_bar_side_margin"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="0dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/phone_player_icon_ripple"
                android:clickable="true"
                android:contentDescription="@string/phone_player_desc_back"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/phone_player_back"
                android:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/episode_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/phone_player_icon_ripple"
                android:clickable="true"
                android:contentDescription="@string/phone_player_desc_more"
                android:focusable="true"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/phone_player_more" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/transport_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_previous"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/phone_player_transport_disc"
                android:clickable="true"
                android:contentDescription="@string/phone_player_desc_previous"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/phone_player_previous"
                android:tint="@android:color/white" />

            <FrameLayout
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="24dp">

                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/phone_player_transport_disc"
                    android:contentDescription="@string/phone_player_desc_play"
                    android:foreground="@drawable/phone_player_icon_ripple"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_pip_pause"
                    android:tint="@android:color/white" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/phone_player_transport_disc"
                android:clickable="true"
                android:contentDescription="@string/phone_player_desc_next"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/phone_player_next"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="@dimen/phone_player_bottom_bar_bottom_margin"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:layoutDirection="ltr"
                android:paddingHorizontal="0dp">

                <TextView
                    android:id="@+id/time_chip"
                    android:textDirection="ltr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/phone_player_time_chip"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="0:00 / 0:00"
                    android:textColor="@android:color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/seek"
                android:layoutDirection="ltr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="1000"
                android:contentDescription="@string/phone_player_desc_seek"
                android:progressDrawable="@drawable/phone_player_seek_track"
                android:thumb="@drawable/phone_player_seek_thumb" />

            <include layout="@layout/phone_player_quick_actions" />
        </LinearLayout>
    </FrameLayout>
    <!-- Buffering indicator: above the controls so it stays visible while the
         chrome is up. -->
    <com.spyou.watch_app.PhoneLoadingIndicatorView
        android:id="@+id/loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="@string/phone_player_desc_loading" />

    <include layout="@layout/phone_player_loading_overlay" />

    </FrameLayout>

    <!-- Portrait info panel (title, actions, description, up next). Inflated
         on demand so landscape starts pay nothing; gone in fullscreen. -->
    <ViewStub
        android:id="@+id/watch_info_stub"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inflatedId="@+id/watch_info"
        android:layout="@layout/phone_watch_info" />

</LinearLayout>
