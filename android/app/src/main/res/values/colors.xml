<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand background (AppColors.defaultBg = 0xFF0B0B0F). Used for the native
         launch window so there's no white/black flash before the Flutter splash
         paints — the launch screen matches the app's dark UI. -->
    <color name="launch_bg">#FF0B0B0F</color>
    <color name="ic_launcher_bg">#000000</color>
    <!-- The extension-settings fallback screen (AniyomiSettingsActivity /
         MihonSettingsActivity). Without these it resolves Material's factory
         colours and the header comes out purple. Mirrors AppColors.surface /
         accent / textPrimary. -->
    <color name="settings_surface">#FF16161C</color>
    <color name="settings_accent">#FFFF4D57</color>
    <color name="settings_text">#FFFFFFFF</color>
    <color name="phone_player_background">#FF000000</color>
    <color name="phone_player_surface">#FF211E26</color>
    <color name="phone_player_surface_container">#E6302A33</color>
    <!-- MPV default accent (Coral) + matching ripple. -->
    <color name="phone_player_accent">#FFFF4D57</color>
    <color name="phone_player_ripple">#554D57FF</color>
    <color name="phone_player_primary_ripple">#55FFFFFF</color>
    <color name="phone_player_on_primary">#FFFFFFFF</color>
    <color name="phone_player_on_surface">#FFF9F4F5</color>
    <color name="phone_player_on_surface_variant">#FFC7BEC2</color>
    <color name="phone_player_outline">#52FFFFFF</color>
    <!-- MPV-matched chrome: 45% black transport discs, 30% black capsules
         (bars, time chip), 24% white seek base, 55% white buffered. -->
    <color name="phone_player_disc">#73000000</color>
    <color name="phone_player_capsule">#4D000000</color>
    <color name="phone_player_track_inactive">#3DFFFFFF</color>
    <color name="phone_player_buffered">#8CFFFFFF</color>
    <color name="phone_player_scrim">#D90B0B0F</color>
</resources>
